# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Database Configuration
# NEXT_PUBLIC_SUPABASE_URL: The REST API URL for your Supabase project
NEXT_PUBLIC_SUPABASE_URL="https://vdoabvrhapptxvdkymlp.supabase.co"

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: The public/anon publishable key for client-side queries
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_jH9XPLPz-q3jOIQLBxXPlA_6PBprcsf"

# Admin Portal Credentials
# ADMIN_EMAIL: Login email for the administrative management panel
ADMIN_EMAIL="limon@technobd.com"
# ADMIN_PASSWORD: Password for the administrative management panel
ADMIN_PASSWORD="admin@123"
NEXT_PUBLIC_ADMIN_EMAIL="limon@technobd.com"
NEXT_PUBLIC_ADMIN_PASSWORD="admin@123"


